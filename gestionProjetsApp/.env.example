# Environment Variables for Development
# Copy these to your system environment or create a .env file (not recommended for production)

# Database Configuration
DB_USERNAME=root
DB_PASSWORD=

# JWT Configuration  
# Generate a new secret using: openssl rand -base64 64
# This is a temporary development secret - CHANGE THIS!
JWT_SECRET=covoiturageSecretKeyForJWTTokenGenerationMustBeLongEnoughForHS512Algorithm2024
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# For production, use a proper secrets management system like:
# - AWS Secrets Manager
# - Azure Key Vault
# - HashiCorp Vault
# - Kubernetes Secrets
